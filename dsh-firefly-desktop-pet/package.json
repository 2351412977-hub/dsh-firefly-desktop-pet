{
  "name": "dsh-firefly",
  "version": "1.3.0",
  "description": "An interactive Firefly desk pet for the DeepSeek Harness Web UI.",
  "type": "module",
  "license": "MIT",
  "author": "dsh-firefly contributors",
  "homepage": "https://github.com/OWNER/dsh-firefly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/dsh-firefly.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/dsh-firefly/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "desktop-pet",
    "mascot",
    "firefly"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.png",
    "locale/*.json",
    "assets/*.webp",
    "README.md",
    "README.zh.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "test": "node scripts/smoke.mjs",
    "check": "npm run validate && npm test",
    "sync-sprite": "node scripts/sync-sprite.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-layout"]
    }
  }
}
